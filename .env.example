# Application Configuration
PROJECT_NAME=AI-Powered Predictive Electricity Billing System
VERSION=1.0.0
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/electricity_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External APIs
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

SMART_METER_API_KEY=your_smart_meter_api_key_here
SMART_METER_API_URL=https://api.smartmeter.example.com

UTILITY_TARIFF_API_KEY=your_utility_api_key_here
UTILITY_TARIFF_API_URL=https://api.utility.example.com


# Location Configuration
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
DEFAULT_REGION=Karnataka

# ML Configuration
MODEL_PATH=models/
MODEL_UPDATE_INTERVAL=86400
PREDICTION_UPDATE_INTERVAL=600
PREDICTION_ERROR_THRESHOLD=0.1
PATTERN_LEARNING_WINDOW_DAYS=30
MIN_DATA_POINTS_FOR_PREDICTION=100

# Alert Configuration
ALERT_THRESHOLD_PERCENTAGE=20.0
ALERT_CHECK_INTERVAL=3600

# Email Notifications
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@electricitybilling.ai

# SMS Notifications (Twilio)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase)
PUSH_NOTIFICATION_ENABLED=false
FCM_SERVER_KEY=your_fcm_server_key

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Feature Flags
ENABLE_WEATHER_INTEGRATION=true
ENABLE_APPLIANCE_DETECTION=true
ENABLE_RL_RECOMMENDATIONS=true
ENABLE_SOCIAL_COMPARISON=false

# Performance
CACHE_ENABLED=true
ASYNC_PROCESSING=true
MAX_CONCURRENT_PREDICTIONS=10

# Data Retention (days)
USAGE_DATA_RETENTION_DAYS=730
PREDICTION_HISTORY_RETENTION_DAYS=365
ALERT_HISTORY_RETENTION_DAYS=90

# Default Tariff Configuration (Indian Tariff Example)
DEFAULT_CURRENCY=INR
FIXED_CHARGE=50.0

# Tariff Slabs (as JSON string or configure in code)
# 0-100 units: ₹3.50/unit
# 101-200 units: ₹4.50/unit
# 201-400 units: ₹6.00/unit
# 401-500 units: ₹7.00/unit
# 500+ units: ₹8.00/unit
